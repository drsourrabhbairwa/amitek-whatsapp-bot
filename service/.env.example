# Copy this file to .env and fill it in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction
# pooler" (port 6543). Copy it whole and put your database password in place of
# [YOUR-PASSWORD]. The pooler survives a laptop going to sleep far better than a
# direct connection, which is why we use it and not port 5432.
DATABASE_URL=

# Which company this service runs for. AMITEK on your Supabase project:
COMPANY_ID=cb9ce33d-21ba-46d6-9bdd-19b3bacafcf9

# --- WhatsApp (BlueTick, which fronts the Meta Cloud API) -----------------
# BlueTick -> Bulk Campaign -> API details. The token expires when BlueTick
# regenerates it, so if sending starts failing with "invalid call", copy it again.
WA_API_URL=https://crmapi.bluetickapi.com/api/meta
WA_API_VERSION=v19.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=

# The secret half of the webhook URL you paste into BlueTick -> Webhooks.
# Make it long and random; anyone who knows it can post messages to the bot.
WEBHOOK_SECRET=

# --- Claude ---------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Safety ---------------------------------------------------------------
# false = the bot works out every reply and writes it to the database, but sends
# nothing on WhatsApp. Leave it false until you have watched a few replies and
# agree with them. This is the switch that stops a bad prompt messaging 34,000 people.
SEND_ENABLED=false

# Hours the bot stays quiet on a lead after a human replies to them by hand.
HUMAN_TAKEOVER_HOURS=12

# Where hot leads and campaign alerts go (country code, no +).
SALES_WHATSAPP=919660031171

# --- Server ---------------------------------------------------------------
PORT=8000
# Sending hours are measured in this timezone. Not called TZ on purpose —
# that name belongs to the operating system.
BOT_TZ=Asia/Kolkata
