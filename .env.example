# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# BlueTick (Meta Cloud API proxy) - from Bulk Campaign > API details
WA_API_URL=https://crmapi.bluetickapi.com/api/meta
WA_API_VERSION=v19.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=

# Secret part of the webhook URL you paste into BlueTick > Webhooks
WEBHOOK_SECRET=change-me-long-random-string

# Database: sqlite for testing, Postgres in production
DATABASE_URL=sqlite:///./bot.db

# Where hot leads go (WhatsApp number with country code, no +)
SALES_WHATSAPP=
# Optional approved utility template for lead alerts (needed if the salesperson
# has not messaged the bot number in the last 24 hours). Body vars: name, phone, summary
SALES_ALERT_TEMPLATE=

# Safety switch: when false, the bot logs replies but sends nothing
SEND_ENABLED=false
# Hours the bot stays quiet after a human replies from Live Chat
HUMAN_TAKEOVER_HOURS=12
